<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ReconX - File Upload</title>
    <!-- Dropzone.js CSS -->
    <link rel="stylesheet" href="https://unpkg.com/dropzone@5/dist/min/dropzone.min.css" type="text/css" />
    <style>
        body { font-family: Arial, sans-serif; margin: 2em; }
        .container { max-width: 900px; margin: auto; }
        #file-upload-zone { border: 2px dashed #007bff; border-radius: 5px; background: #f9f9f9; }
        table { width: 100%; border-collapse: collapse; margin-top: 2em; }
        th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
        th { background-color: #f2f2f2; }
        .status { padding: 3px 8px; border-radius: 10px; color: white; font-size: 0.8em; }
        .status-uploaded { background-color: #007bff; }
        .status-processing { background-color: #ffc107; color: black; }
        .status-processed, .status-completed { background-color: #28a745; }
        .status-error, .status-failed { background-color: #dc3545; }
    </style>
</head>
<body>

<div class="container">
    <h1>Upload Reconciliation Files</h1>
    <p>Drag and drop .csv or .xlsx files below, or click to select.</p>

    <!-- Dropzone Form -->
    <form action="/api/uploads" class="dropzone" id="file-upload-zone">
        <div class="dz-message" data-dz-message><span>Drop files here or click to upload</span></div>
        <!-- Add a hidden input for file_type if needed -->
        <input type="hidden" name="file_type" value="bank_statement" />
    </form>

    <div id="upload-feedback"></div>

    <h2>Uploaded Files</h2>
    <table id="files-table">
        <thead>
            <tr>
                <th>Filename</th>
                <th>Upload Date</th>
                <th>Status</th>
                <th>Uploaded By</th>
                <th>File Type</th>
            </tr>
        </thead>
        <tbody id="files-table-body">
            <!-- Rows will be inserted here by JavaScript -->
        </tbody>
    </table>
</div>

<!-- Dropzone.js JS -->
<script src="https://unpkg.com/dropzone@5/dist/min/dropzone.min.js"></script>

<script>
    // --- Dropzone Configuration ---
    Dropzone.options.fileUploadZone = {
        paramName: "reconFile", // Matches the .single('reconFile') in the backend
        maxFilesize: 50, // MB
        acceptedFiles: ".csv,.xlsx",
        addRemoveLinks: true,
        dictDefaultMessage: "Drop CSV or XLSX files here or click to upload",
        dictInvalidFileType: "You can't upload files of this type. Only .csv and .xlsx are allowed.",

        init: function() {
            const myDropzone = this;

            // Handle successful upload
            this.on("success", function(file, response) {
                console.log("Success:", response.message);
                // Remove the file from the preview
                myDropzone.removeFile(file);
                // Refresh the list of uploaded files
                fetchAndDisplayFiles();
            });

            // Handle error
            this.on("error", function(file, message) {
                const feedback = document.getElementById('upload-feedback');
                feedback.innerHTML = `<p style="color: red;">Error uploading ${file.name}: ${message.message || message}</p>`;
                // You might want to remove the file from the preview after a delay
                setTimeout(() => myDropzone.removeFile(file), 3000);
            });
        }
    };

    // --- File List Display ---
    async function fetchAndDisplayFiles() {
        try {
            const response = await fetch('/api/uploads');
            if (!response.ok) throw new Error('Failed to fetch file list.');
            
            const data = await response.json();
            const tableBody = document.getElementById('files-table-body');
            tableBody.innerHTML = ''; // Clear existing rows

            data.files.forEach(file => {
                const row = `
                    <tr>
                        <td>${file.original_filename}</td>
                        <td>${new Date(file.uploaded_at).toLocaleString()}</td>
                        <td><span class="status status-${file.status.toLowerCase()}">${file.status}</span></td>
                        <td>${file.uploaded_by_username}</td>
                        <td>${file.file_type.replace('_', ' ')}</td>
                    </tr>
                `;
                tableBody.innerHTML += row;
            });
        } catch (error) {
            console.error('Error fetching files:', error);
            document.getElementById('files-table-body').innerHTML = `<tr><td colspan="5" style="color: red;">${error.message}</td></tr>`;
        }
    }

    // Initial load of the file list
    document.addEventListener('DOMContentLoaded', fetchAndDisplayFiles);
</script>

</body>
</html>